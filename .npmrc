# Disable pnpm 10+'s pre-script lockfile verification so scripts (dev/build/etc.)
# don't re-error on the "ignored builds" state. Builds are already approved via
# package.json's `pnpm.onlyBuiltDependencies` field; the four native packages
# (electron, better-sqlite3, esbuild, biome) had their binaries extracted at install.
verify-deps-before-run=false

# Build approvals carry through to all install runs.
auto-install-peers=true

# Use a flat (npm-style) node_modules layout instead of pnpm's default content-
# addressable .pnpm/ tree. Required for electron-builder + NSIS on Windows: the
# default pnpm paths nest packages under deep `.pnpm/<pkg>@<ver>_<hash>/node_modules/<pkg>/`
# directories which routinely exceed Windows' MAX_PATH (260 chars) on
# moderately-deep project paths (e.g. inside a worktree). NSIS's makensis.exe
# can't open files past 260 chars and aborts mid-bundle. `hoisted` plus
# `shamefully-hoist` flattens transitives to the top of node_modules so
# package-internal asset paths fit within the limit.
# Trade-off: loses pnpm dedup, but this is a single-package project so dedup
# wasn't doing meaningful work anyway.
node-linker=hoisted
shamefully-hoist=true

# Disable peer-dep hash suffixes on `.pnpm/<pkg>@<ver>_<hash>/` directories.
# The default `_<peer-hash>_<32-hex>` suffix can add 40+ chars per directory,
# easily blowing MAX_PATH for transitive deps like app-builder-lib that nest
# deep template assets. Turning dedupe off shortens directory names to
# `<pkg>@<ver>/` flat. Acceptable cost on a single-package project.
dedupe-peer-dependents=false
