# Disable pnpm 10+'s pre-script lockfile verification so scripts (dev/build/etc.)
# don't re-error on the "ignored builds" state. Builds are already approved via
# package.json's `pnpm.onlyBuiltDependencies` field; the four native packages
# (electron, better-sqlite3, esbuild, biome) had their binaries extracted at install.
verify-deps-before-run=false

# Build approvals carry through to all install runs.
auto-install-peers=true
